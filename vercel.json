{
  "version": 2,
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health.js" },
    { "source": "/api/sample", "destination": "/api/sample.js" },
    { "source": "/api/themes", "destination": "/api/themes.js" },
    { "source": "/api/preview", "destination": "/api/preview.js" },
    { "source": "/api/convert", "destination": "/api/convert.js" },
    { "source": "/api/convert-batch", "destination": "/api/convert-batch.js" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}